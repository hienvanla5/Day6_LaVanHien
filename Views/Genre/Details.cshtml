@model Day6_LaVanHien.Models.Genre

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Genre</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Movies)
        </dt>
        <dd class = "col-sm-10">
            @if (Model.Movies?.Any() == true)
            {
                <ul>
                    @foreach (var movie in Model.Movies)
                    {
                        <li>@movie.Title</li>
                    }
                </ul>
            }
            else
            {
                <span class="text-muted">Chưa có phim</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
